# ── ARS INTENT ARCHITECT - V3.2.2 MANIFEST ──
# Required environment variables for ARS (Backend + Frontend).
# Keep real secrets only in .env or a secret manager; templates must never contain production values.

# Backend: Firebase / auth
FIREBASE_SERVICE_ACCOUNT_PATH=service-account.json

# Backend: Web search / tool APIs
TAVILY_API_KEY=

# Backend: LLM configuration
LLM_BACKEND=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# Backend: cache / vector store
REDIS_URL=
CHROMA_ENABLED=true
CHROMA_HOST=https://api.trychroma.com
CHROMA_PORT=443
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=ARS

# Backend: Sandbox execution (Modal required for code execution)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Backend: optional encryption for stored secrets
SETTINGS_ENCRYPTION_KEY=

# Frontend: Firebase config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
