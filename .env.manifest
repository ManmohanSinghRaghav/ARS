# ── ARS INTENT ARCHITECT - V3.2.2 MANIFEST ──
# Environment variables used by ARS (Backend + Frontend).
# Keep secrets ONLY in .env / secret manager; templates must not contain real keys.

# Firebase Auth/Firestore
FIREBASE_SERVICE_ACCOUNT_PATH=service-account.json

# Tool APIs (Optional but recommended)
TAVILY_API_KEY=""

# Cache / Vector Memory
# Redis is used for LiteLLM request/response caching when set; otherwise disk cache is used.
REDIS_URL="" # Upstash
CHROMA_API_KEY=""
CHROMA_TENANT=""
CHROMA_DATABASE="ARS"

# Model APIs
GEMINI_API_KEY="" # Required for Gemini 3.1 Pro and Flash-Lite
GROQ_API_KEY=""   # Required for Llama 3.1 8B Real-Time Router

# Sandbox Environments (Modal REQUIRED for code execution)
MODAL_TOKEN_ID=""
MODAL_TOKEN_SECRET=""

# Secrets at rest (Optional)
# If set, encrypts per-user API keys stored in Firestore.
SETTINGS_ENCRYPTION_KEY=""
