# ── API Keys ──
TAVILY_API_KEY=your-tavily-api-key-here

# ── LLM Backend ──
# Options: mlx | ollama  (auto-detected from OS if blank)
LLM_BACKEND=

# ── MLX settings (macOS only) ──
MLX_MODEL=mlx-community/Qwen2.5-3B-Instruct-bf16

# ── Ollama settings (any platform) ──
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434
