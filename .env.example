# ── ARS — Unified Environment Variables ──
# Copy this file to .env and fill in values. Do not commit real secrets.

# ── Backend: Firebase ──
FIREBASE_SERVICE_ACCOUNT_PATH=service-account.json

# ── Backend: General API Keys ──
TAVILY_API_KEY=

# ── Backend: LLM Configuration ──
# Current pipeline implementation expects Gemini; Groq is optional for extraction/critic.
LLM_BACKEND=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Backend: Cache / Vector DB ──
REDIS_URL=
CHROMA_ENABLED=true
CHROMA_HOST=https://api.trychroma.com
CHROMA_PORT=443
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=ARS

# ── Backend: Sandbox Execution (Modal REQUIRED for code execution) ──
# Setup reference:
#   pip install modal
#   python -m modal setup
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ── Backend: Optional Cloud Storage ──
FIREBASE_STORAGE_BUCKET=

# ── Backend: Secrets at Rest (optional) ──
# Used to encrypt per-user API keys stored in Firestore.
SETTINGS_ENCRYPTION_KEY=

# ── Frontend: Firebase Config ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
