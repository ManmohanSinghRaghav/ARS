# ── ARS — Unified Environment Variables ──
# Copy this file to .env and fill in values. Do not commit real secrets.

# ── Backend: Firebase ──
FIREBASE_SERVICE_ACCOUNT_PATH=service-account.json

# ── Backend: General API Keys ──
TAVILY_API_KEY=

# ── Backend: LLM Configuration ──
LLM_BACKEND=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Backend: Dynamic Model Categories (server-level defaults) ──
# Users can override these per-account via the Settings page.
# Use LiteLLM provider prefixes: gemini/, groq/, openai/

# Heavy Reasoning Engine → used by Lead Scientist, Writer, Adversarial Critic
DEFAULT_HEAVY_MODEL=groq/meta-llama/llama-4-scout-17b-16e-instruct
DEFAULT_HEAVY_RPM=30
DEFAULT_HEAVY_TPM=30000

# High-Volume Fallback (For when you need to ingest 10+ papers)
DEFAULT_HEAVY_FALLBACK_MODEL=gemini/gemini-3.1-flash-lite-preview
DEFAULT_HEAVY_FALLBACK_RPM=15
DEFAULT_HEAVY_FALLBACK_TPM=250000

# Light Fast Engine → used by Literature Researcher (extraction / summarization)
DEFAULT_LIGHT_MODEL=gemini/gemini-3.1-flash-lite-preview
DEFAULT_LIGHT_RPM=15
DEFAULT_LIGHT_TPM=250000

# Fast Snippet Fallback
DEFAULT_LIGHT_FALLBACK_MODEL=groq/llama-3.1-8b-instant
DEFAULT_LIGHT_FALLBACK_RPM=30
DEFAULT_LIGHT_FALLBACK_TPM=6000

# ── Backend: Cache / Vector DB ──
REDIS_URL=
CHROMA_ENABLED=true
CHROMA_HOST=https://api.trychroma.com
CHROMA_PORT=443
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=ARS

# ── Backend: Sandbox Execution (Modal REQUIRED for code execution) ──
# Setup reference:
#   pip install modal
#   python -m modal setup
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ── Backend: Optional Cloud Storage ──
FIREBASE_STORAGE_BUCKET=

# ── Backend: Secrets at Rest (optional) ──
# Used to encrypt per-user API keys stored in Firestore.
SETTINGS_ENCRYPTION_KEY=

# ── Frontend: Firebase Config ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
