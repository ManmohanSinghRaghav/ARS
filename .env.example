# ── ARS — Autonomous Research Scientist ──
# Copy this file to .env and fill in values
# This file is loaded by backend/app/config.py

# ── Database ──
DATABASE_URL=sqlite:///./ars.db

# ── JWT Secret (CHANGE THIS in production!) ──
SECRET_KEY=change-me-in-production-use-a-random-64-char-string

# ── API Keys ──
TAVILY_API_KEY=your-tavily-api-key-here

# ── LLM Backend ──
# Options: mlx (macOS only) | ollama (any platform)
LLM_BACKEND=ollama

# ── MLX settings (macOS only) ──
MLX_MODEL=mlx-community/Qwen2.5-3B-Instruct-bf16

# ── Ollama settings (any platform) ──
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434

# ── CORS (comma-separated origins) ──
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
