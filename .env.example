# ── ARS — Unified Environment Variables ──
# Copy this file to .env and fill in values (DO NOT COMMIT real secrets)

# ── Backend: Firebase ──
FIREBASE_SERVICE_ACCOUNT_PATH=service-account.json

# ── Backend: General API Keys ──
TAVILY_API_KEY=

# ── Backend: LLM Configuration ──
# Note: current CrewAI pipeline implementation expects Gemini (Groq optional for extraction/critic).
LLM_BACKEND=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional local backends (only relevant if you wire them into the pipeline)
MLX_MODEL=mlx-community/Qwen2.5-3B-Instruct-bf16
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434

# ── Backend: Cache / Vector DB ──
REDIS_URL=
CHROMA_ENABLED=false
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_API_KEY=

# ── Backend: Sandbox Execution (Modal REQUIRED for code execution) ──
# Setup reference:
#   pip install modal
#   python -m modal setup
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ── Backend: Firebase Cloud Storage ──
FIREBASE_STORAGE_BUCKET=

# ── Backend: Secrets at Rest (optional) ──
# Used to encrypt per-user API keys stored in Firestore.
SETTINGS_ENCRYPTION_KEY=

# ── Frontend: Firebase Config ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
